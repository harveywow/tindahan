{
  "name": "tindahan",
  "version": "1.0.0",
  "description": "Tindahan — a sari-sari store management system built with vanilla HTML, CSS, and JavaScript.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx http-server . -p 5500 -c-1",
    "test": "node tests/run-node.js",
    "lint": "eslint js tests",
    "format": "prettier --write \"js/**/*.js\" \"tests/**/*.js\" \"css/**/*.css\" index.html",
    "format:check": "prettier --check \"js/**/*.js\" \"tests/**/*.js\" \"css/**/*.css\" index.html"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0"
  }
}
